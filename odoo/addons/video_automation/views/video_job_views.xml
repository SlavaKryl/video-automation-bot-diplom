<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_job_tree" model="ir.ui.view">
        <field name="name">video.job.tree</field>
        <field name="model">video.job</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="source"/>
                <field name="state"/>
                <field name="attempt_count"/>
                <field name="max_retries"/>
                <field name="approved_by_id"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_video_job_form" model="ir.ui.view">
        <field name="name">video.job.form</field>
        <field name="model">video.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_for_approval" type="object" string="Submit for Approval" class="btn-secondary" invisible="state not in ['draft','failed']"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending_approval'"/>
                    <button name="action_retry" type="object" string="Retry" class="btn-secondary" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,approved,processing,published,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source"/>
                            <field name="external_ref"/>
                            <field name="max_retries"/>
                        </group>
                        <group>
                            <field name="attempt_count" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <group>
                                <field name="transcription"/>
                                <field name="content_preview"/>
                                <field name="last_error" readonly="1"/>
                            </group>
                        </page>
                        <page string="Assets">
                            <field name="asset_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="asset_type"/>
                                    <field name="storage_uri"/>
                                    <field name="state"/>
                                    <field name="error_message"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Publications">
                            <field name="publication_ids">
                                <tree editable="bottom">
                                    <field name="platform"/>
                                    <field name="state"/>
                                    <field name="external_id"/>
                                    <field name="last_error"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_video_asset_tree" model="ir.ui.view">
        <field name="name">video.asset.tree</field>
        <field name="model">video.asset</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="job_id"/>
                <field name="asset_type"/>
                <field name="state"/>
                <field name="storage_uri"/>
            </tree>
        </field>
    </record>

    <record id="view_video_publication_tree" model="ir.ui.view">
        <field name="name">video.publication.tree</field>
        <field name="model">video.publication</field>
        <field name="arch" type="xml">
            <tree>
                <field name="job_id"/>
                <field name="platform"/>
                <field name="state"/>
                <field name="external_id"/>
                <field name="last_error"/>
            </tree>
        </field>
    </record>

    <record id="action_video_job" model="ir.actions.act_window">
        <field name="name">Video Jobs</field>
        <field name="res_model">video.job</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_video_asset" model="ir.actions.act_window">
        <field name="name">Video Assets</field>
        <field name="res_model">video.asset</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="action_video_publication" model="ir.actions.act_window">
        <field name="name">Video Publications</field>
        <field name="res_model">video.publication</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_video_automation_root" name="Video Automation" sequence="30"/>
    <menuitem id="menu_video_jobs" name="Jobs" parent="menu_video_automation_root" action="action_video_job" sequence="10"/>
    <menuitem id="menu_video_assets" name="Assets" parent="menu_video_automation_root" action="action_video_asset" sequence="20"/>
    <menuitem id="menu_video_publications" name="Publications" parent="menu_video_automation_root" action="action_video_publication" sequence="30"/>
</odoo>
